generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───
enum BusinessStatus {
  TRIAL
  DEMO
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum BusinessType {
  barberia
  estetica
  gimnasio
  lavadero
  taller
  clinica
  cancha
  menu
  general
}

enum PaymentStatus {
  pending
  paid
  overdue
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  LOCAL
  TRANSFER
}

// ─── MODELOS DE AUTENTICACIÓN (NEXTAUTH) ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?    // Para login manual
  mustChangePassword Boolean @default(false)
  passwordChangedAt DateTime?
  sessionVersion Int        @default(1)
  lastLoginAt   DateTime?
  failedLoginCount Int      @default(0)
  role          String     @default("USER")
  accounts      Account[]
  sessions      Session[]
  businesses    Business[]
}

// ─── MODELOS DEL SAAS (NEGOCIOS Y TURNOS) ───

model Business {
  id            String    @id @default(cuid())
  name          String
  subdomain     String    @unique
  customDomain  String?   @unique
  domainVerifiedAt DateTime?
  domainVerificationTokenHash String?
  email         String?
  phone         String?
  description   String?
  type          BusinessType?   @default(general)
  status        BusinessStatus?   @default(DEMO)
  accentColor String? @default("#f59e0b")
  timezone    String? @default("America/Mexico_City")
  
  // Facturación
  paymentAmount Decimal?    @default(0) @db.Decimal(12,2)
  paymentStatus PaymentStatus?   @default(pending)
  demoExpiresAt DateTime?
  nextPayment   DateTime?

  // 🌟 NUEVOS CAMPOS DEL DASHBOARD 🌟
  logoUrl        String?
  bannerUrl      String?
  primaryColor   String?   @default("#4f46e5")
  secondaryColor String?   @default("#ffffff")
  fontFamily     String?   @default("sans")
  layoutConfig   Json?
  publishedConfig Json?
  paymentData    Json?
  
  // 🌟 NUEVOS CAMPOS PRIVADOS 🌟
  callMeBotApiKey String?
  bankDetails    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  // Relaciones
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  sales         Sale[]
  employees     Employee[]
  suppliers     Supplier[]
  tables        Table[]
  orders        Order[]
  messages      Message[]
  whatsappConn  WhatsappConnection?
  whatsappQueue WhatsappMessageQueue[]
}

model WhatsappConnection {
  id            String   @id @default(cuid())
  businessId    String?  @unique
  provider      String   @default("CLOUD_API") // CLOUD_API, BAILEYS
  phoneNumberId String?
  accessToken   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model WhatsappMessageQueue {
  id           String   @id @default(cuid())
  businessId   String
  toPhone      String
  message      String   @db.Text
  status       String   @default("PENDING") // PENDING, SENT, FAILED, PROCESSING
  retries      Int      @default(0)
  attempts     Int      @default(0)
  nextRetryAt  DateTime?
  lockedAt     DateTime?
  idempotencyKey String? @unique
  senderId     String?
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// 🌟 NUEVA TABLA PARA LOS TURNOS 🌟
model Appointment {
  id          String   @id @default(cuid())
  businessId  String
  clientName  String
  clientPhone String
  clientEmail String?
  date        DateTime
  status      AppointmentStatus   @default(PENDING) // PENDING, CONFIRMED, CANCELLED, COMPLETED
  serviceName String?
  serviceId   String?
  notes       String?
  patente     String?
  employeeId  String?
  source      String? @default("WEB") // WEB, ADMIN, WA
  publicTrackingTokenHash String? @unique
  paymentMethod PaymentMethod? @default(LOCAL) // LOCAL, TRANSFER
  paymentReference String? @unique
  whatsappSent Boolean @default(false)
  reminderSent Boolean @default(false)
  cancelledAt  DateTime?
  cancelReason String?
  concurrencyToken String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sale        Sale?

  @@index([businessId, date])
  @@index([businessId, status, date])
}

// 🌟 NUEVOS MODELOS PARA EL CRM 🌟
model Sale {
  id          String   @id @default(cuid())
  businessId  String
  type        String   // "SERVICE" o "PRODUCT"
  itemName    String
  amount      Decimal  @db.Decimal(12,2)
  currency    String   @default("MXN")
  employeeId  String?
  appointmentId String? @unique
  date        DateTime @default(now())
  deletedAt   DateTime?

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([businessId, date])
}

model Employee {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  role        String?
  phone       String?

  // Financial and HR
  salaryType  String?  @default("FIXED") // FIXED, PERCENTAGE, HOURLY
  salaryValue Decimal? @default(0) @db.Decimal(12,2)
  servicesDone Int?    @default(0)
  hoursWorked Decimal? @default(0) @db.Decimal(10,2)

  // Public Profile for Landing
  imageUrl    String?
  bio         String?
  isPublic    Boolean  @default(true)
  deletedAt   DateTime?

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales       Sale[]
  appointments Appointment[]

  @@index([businessId])
}

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  phone       String?
  products    String?
  deletedAt   DateTime?

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// 🌟 NUEVOS MODELOS PARA GASTRONOMÍA (MENÚ) 🌟
model Table {
  id          String   @id @default(cuid())
  businessId  String
  number      Int
  status      String   @default("CLOSED") // OPEN, CLOSED
  qrCodeUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders      Order[]
}

model Order {
  id            String   @id @default(cuid())
  businessId    String
  tableId       String?
  type          String   @default("TAKEAWAY") // TAKEAWAY, DELIVERY, LOCAL
  status        String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  customerName  String?
  customerPhone String?
  address       String?
  items         Json     // Array de items del carrito
  total         Decimal  @default(0) @db.Decimal(12,2)
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table         Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
}

// 🌟 NUEVOS MODELOS PARA SOPORTE Y ALERTAS 🌟

model Message {
  id         String   @id @default(cuid())
  businessId String
  content    String   @db.Text
  senderType String   @default("USER") // USER, ADMIN
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Alert {
  id         String   @id @default(cuid())
  content    String   @db.Text
  type       String   @default("info") // info, warning, success
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}